   "file_sha256": "79ef7ca776e42abe1f46caee13ea09bd19f1e2d0b1620d8d5d200258f33b47bf",
   "statement": "def RiemannZetaZerosOnLine : Prop :=\n  ∀ s : ℂ, riemannZeta s = 0 → (¬∃ n : ℕ, s = -2 * ((n : ℂ) + 1)) → s ≠ 1 → s.re = 1 / 2",
   "in_unit": false,
   "binders": [],
   "binders_basis": "text"
  },
  "halfPlane": {
   "name": "DirichletLNonvanishingRightOfHalf",
   "id": "Statements:6:5",
   "kind": "def",
   "file": "Statements.lean",
   "lines": [
    6,
    8
   ],
   "file_sha256": "79ef7ca776e42abe1f46caee13ea09bd19f1e2d0b1620d8d5d200258f33b47bf",
   "statement": "def DirichletLNonvanishingRightOfHalf : Prop :=\n  ∀ (N : ℕ) [NeZero N] (χ : DirichletCharacter ℂ N) (s : ℂ),\n    1 / 2 < s.re → (χ ≠ 1 ∨ s ≠ 1) → DirichletCharacter.LFunction χ s ≠ 0",
   "in_unit": false,
   "binders": [],
   "binders_basis": "text"
  },
